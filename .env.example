# Google OAuth credentials for the local Supabase stack (`pnpm db:start`).
#
# Create an OAuth 2.0 Client ID of type "Web application" in the Google Cloud Console with:
#   Authorised redirect URI:  http://127.0.0.1:54321/auth/v1/callback   (GoTrue, not Angular)
#   Authorised JavaScript origin:  http://localhost:4200
#
# Copy this file to .env (git-ignored) and fill in the values. Without them `supabase start`
# will refuse to boot, because config.toml enables the Google provider.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
